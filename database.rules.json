{
  "rules": {
    "rooms": {
      "$room": {
        "presentation": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email == 'presenter@panel.local'"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email == 'presenter@panel.local'"
        },
        "viewers": {
          ".read": "auth != null && auth.token.email == 'presenter@panel.local'",
          "$cid": {
            ".write": "auth != null",
            ".validate": "newData.val() == 'uk' || newData.val() == 'en'"
          }
        }
      }
    }
  }
}
